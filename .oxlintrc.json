{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "import", "vitest"],
  "categories": { "correctness": "error" },
  "env": { "builtin": true, "es2022": true },
  "rules": {
    "no-undef": "error",
    "react/immutability": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "react/set-state-in-effect": "warn",
    "react/refs": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/cdk.out/**",
    "apps/web/public/**",
    "apps/web/tools/**",
    "pnpm-lock.yaml",
    "**/*.md",
    "apps/web/src/**/*.json",
    "apps/web/scripts/*-manifest.json",
    "apps/web/scripts/jarvis/*.json"
  ],
  "overrides": [
    { "files": ["apps/web/src/**"], "env": { "browser": true } },
    {
      "files": ["apps/web/src/**/*.js"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/*.jsx", "*.jsx"],
                "message": "A plain module does not import a component. Move the shared name to a .js module."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/components/tacticFaceTexture.js"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": [
        "apps/api/**",
        "apps/web/scripts/**",
        "apps/web/*.config.*",
        "infra/**",
        "**/*.test.*",
        "**/*.spec.*"
      ],
      "env": { "node": true }
    },
    {
      "files": ["infra/test/**"],
      "rules": {
        "vitest/expect-expect": [
          "error",
          {
            "assertFunctionNames": ["expect", "*.has*", "*.resourceCountIs"]
          }
        ]
      }
    }
  ]
}
