# AWS region of both stacks and of the SSM parameters. It must be the region of the Atlas
# cluster, because every API request goes from the Lambda to Atlas and back.
DEPLOY_REGION=eu-central-1
# Email for the budget alert (McpTacticusAccount). Not in git.
BUDGET_EMAIL=
# Atlas connection string with the database user and password.
MONGODB_URI=
# Key for the session token. Make it with: openssl rand -base64 48
SESSION_SECRET=
# Step 6: Discord application id and client secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
