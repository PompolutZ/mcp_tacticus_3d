# Which store local dev uses: memory (default) or mongo.
STORE=memory
# Needed when STORE=mongo. Local Mongo only: the API refuses Atlas strings.
MONGODB_URI=mongodb://localhost:27017
# Database name. Default assist3d.
DB_NAME=assist3d
# Signs the session tokens. Optional: without it a fixed dev value is used.
SESSION_SECRET=
# Discord application values. Without them the Discord login answers 503.
# The dev login still works.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
