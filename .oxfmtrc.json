{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "ignorePatterns": [
    "**/dist/**",
    "**/cdk.out/**",
    "apps/web/public/**",
    "apps/web/tools/**",
    "pnpm-lock.yaml",
    "**/*.md",
    "apps/web/src/**/*.json",
    "apps/web/scripts/*-manifest.json"
  ]
}
